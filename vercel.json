{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?charlestoninvestoragent\\.com"
        }
      ],
      "destination": "https://paulchs.com/investor-friendly-agent-charleston",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?paulkelton\\.com"
        }
      ],
      "destination": "https://paulchs.com/",
      "statusCode": 301
    },
    {
      "source": "/mm",
      "destination": "/market-monday",
      "statusCode": 301
    },
    {
      "source": "/marketmonday",
      "destination": "/market-monday",
      "statusCode": 301
    },
    {
      "source": "/link",
      "destination": "/links",
      "statusCode": 301
    },
    {
      "source": "/bio",
      "destination": "/links",
      "statusCode": 301
    },
    {
      "source": "/offmarket",
      "destination": "/off-market",
      "statusCode": 301
    },
    {
      "source": "/value",
      "destination": "/property-value",
      "statusCode": 301
    },
    {
      "source": "/first-building",
      "destination": "/buying",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/paul-kelton.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"paul-kelton.vcf\""
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
