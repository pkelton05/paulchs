---
// Campaign layout for Charleston Market Monday. Self-contained (own minimal
// masthead, no site nav) so it works as a link-in-bio / newsletter landing
// page. Keeps the compliance footer. Look matches the Market Monday
// newsletter: newspaper black and white, red only for the key points.
import Seo from "../components/Seo.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <Seo {...props} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <main id="main">
      <slot />
    </main>
    <div class="foot">
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --ink: #111111;
    --ink-soft: #444444;
    --paper: #ffffff;
    --newsprint: #f4f4f2;
    --red: #b3121b; /* 6.9:1 on white */
    --rule: #111111;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --wrap: 64rem;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.1875rem;
    line-height: 1.55;
  }
  a {
    color: var(--ink);
    text-underline-offset: 0.15em;
  }
  :focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 2px;
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    background: var(--paper);
    padding: 0.5rem 0.75rem;
    z-index: 10;
  }
  .foot {
    border-top: 4px double var(--rule);
    margin-top: 3rem;
    background: var(--newsprint);
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .foot footer {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
  }
  .foot footer ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .foot address {
    font-style: normal;
  }
  .foot p {
    margin: 0.35rem 0;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
