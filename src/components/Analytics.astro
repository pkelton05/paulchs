---
// Tracks call taps, text taps, and form submits as named events.
// Any element with data-event="name" sends that event on click. Pages can
// also call window.paulTrack("name"). No provider is loaded until Paul picks
// one (data/site.json → analytics.provider: "plausible" | "ga4").
import { site } from "../lib/site";

const provider = site.analytics.provider as "plausible" | "ga4" | null;
const domain = site.analytics.domain;
const ga4Id = (site.analytics as { ga4_id?: string }).ga4_id;
---

{provider === "plausible" && <script is:inline defer data-domain={domain} src="https://plausible.io/js/script.js" />}
{
  provider === "ga4" && ga4Id && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
      <script is:inline define:vars={{ ga4Id }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("config", ga4Id);
      </script>
    </>
  )
}

<script is:inline>
  window.paulTrack = function (name, props) {
    try {
      if (typeof window.plausible === "function") window.plausible(name, props ? { props: props } : undefined);
      if (typeof window.gtag === "function") window.gtag("event", name, props || {});
    } catch (e) {}
  };
  document.addEventListener("click", function (e) {
    var el = e.target && e.target.closest ? e.target.closest("[data-event]") : null;
    if (el) window.paulTrack(el.getAttribute("data-event"), { location: el.getAttribute("data-where") || "" });
  });
</script>
