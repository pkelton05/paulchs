---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import EventStrip from "../components/EventStrip.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBar from "../components/StickyBar.astro";
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  mentionsTide?: boolean;
}

const { mentionsTide = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eef0eb" />
    <link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo {...seo} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <EventStrip />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer mentionsTide={mentionsTide} />
    <StickyBar />
  </body>
</html>
