---
// Title, description, canonical, Open Graph, and optional JSON-LD for every page.
import { site } from "../lib/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, ogImage, jsonLd } = Astro.props;
// build.format "file" makes pathnames end in .html; canonical URLs never do.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, "").replace(/\/$/, "") || "/";
const canonical = new URL(path, Astro.site).href;
// Default share card until per-page images exist (engagement plan P3).
const image = new URL(ogImage ?? "/og/default.png", Astro.site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="sitemap" href="/sitemap-index.xml" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
