---
// Compliance footer – CLAUDE.md section 9. Bracketed values are placeholders
// Paul or the broker-in-charge must confirm before launch (see TODO.md).
import Wordmark from "./Wordmark.astro";
import { site, telHref, officeAddressLine, placeholder } from "../lib/site";
import { mainNav, footerQuestions, privacyLink, live } from "../lib/nav";

interface Props {
  /** Set on any page that mentions or links to Tide Property Management. */
  mentionsTide?: boolean;
}

const { mentionsTide = false } = Astro.props;
const year = new Date().getFullYear();
const nav = live(mainNav);
const questions = live(footerQuestions);
const socials = Object.entries({
  Instagram: site.social.instagram,
  Threads: site.social.threads,
  LinkedIn: site.social.linkedin,
  YouTube: site.social.youtube,
  BiggerPockets: site.social.biggerpockets,
  "GRID podcast": site.social.grid_podcast,
}).filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div>
        <Wordmark tone="light" />
        <address>
          <p>{site.name}, {site.designation}<br />{site.brokerage_line}</p>
          <p>{officeAddressLine}</p>
          <p>
            <a href={telHref} data-event="call_tap" data-where="footer">{site.phone}</a>
            {site.email ? <><br /><a href={`mailto:${site.email}`}>{site.email}</a></> : <><br />{placeholder("NEED: email")}</>}
            <br />Brokerage phone: {site.brokerage_phone ?? placeholder("NEED: brokerage phone")}
          </p>
          {site.license_line && <p>{site.license_line}</p>}
        </address>
      </div>

      {
        nav.length > 0 && (
          <nav aria-label="Footer">
            <ul role="list">
              {nav.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        questions.length > 0 && (
          <nav aria-labelledby="footer-questions">
            <p id="footer-questions" class="heading">Questions I get a lot</p>
            <ul role="list">
              {questions.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        socials.length > 0 && (
          <ul role="list" aria-label="Paul on social media" class="social">
            {socials.map(([label, href]) => (
              <li><a href={href} rel="me noopener">{label}</a></li>
            ))}
          </ul>
        )
      }
    </div>

    {mentionsTide && <p class="disclosure">{site.tide_disclosure}</p>}

    <p class="legal">
      © {year} {site.name} · <span class="eho">Equal Housing Opportunity</span>
      {privacyLink.live && <> · <a href={privacyLink.href}>{privacyLink.label}</a></>}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--piling);
    color: var(--oyster);
    font-size: var(--text-small);
    padding-block: var(--space-4) var(--space-3);
    margin-top: var(--space-4);
  }
  .top {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 48rem) {
    .top {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
  address {
    font-style: normal;
    margin-top: var(--space-2);
  }
  address p {
    margin-bottom: 0.75rem;
  }
  a {
    color: var(--oyster);
    text-decoration-color: var(--spartina);
  }
  li + li {
    margin-top: 0.4rem;
  }
  .heading {
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .disclosure,
  .legal {
    max-width: none;
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid rgba(238, 240, 235, 0.2);
  }
  .site-footer :focus-visible {
    outline-color: var(--spartina);
  }
</style>
