---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  mentionsTide?: boolean;
}

const { mentionsTide = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} />
  </head>
  <body>
    <a href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer mentionsTide={mentionsTide} />
  </body>
</html>
