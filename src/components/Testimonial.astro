---
// Real client words only. With no quote, renders a visible placeholder.
interface Props {
  quote?: string;
  name?: string;
  dealType?: string;
}
const { quote, name, dealType } = Astro.props;
---

{
  quote ? (
    <figure class="testimonial">
      <blockquote><p>{quote}</p></blockquote>
      <figcaption>
        {name}
        {dealType && <span> · {dealType}</span>}
      </figcaption>
    </figure>
  ) : (
    <figure class="testimonial">
      <span class="placeholder">[TESTIMONIAL – need from Paul: short quote, name or initials, deal type]</span>
    </figure>
  )
}

<style>
  .testimonial {
    margin: 0;
    padding-left: var(--space-3);
    border-left: 3px solid var(--spartina);
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    font-size: 1.375rem;
    line-height: 1.45;
  }
  figcaption {
    font-size: var(--text-small);
    color: var(--pluff-soft);
  }
</style>
