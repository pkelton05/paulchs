---
// /links – Instagram link-in-bio page, replacing linktr.ee/pk_chs.
// Self-contained (no site nav) so it loads fast on a phone. Links mirror
// Paul's Linktree, with Market Monday added at the top.
import Seo from "../components/Seo.astro";
import { site, officeAddressLine } from "../lib/site";

type Item = { label: string; sub?: string; href: string; external?: boolean; download?: boolean; featured?: boolean };

const links: Item[] = [
  {
    label: "Charleston Market Monday",
    sub: "Free weekly Charleston market update",
    href: "/market-monday",
    featured: true,
  },
  { label: "GRID Charleston", sub: "RSVP to the next event", href: "https://www.meetup.com/grid-charleston/", external: true },
  {
    label: "GRID Charleston investor network",
    sub: "Email sign-up",
    href: "https://www.gridinvestor.com/groups/grid-charleston",
    external: true,
  },
  { label: "Let's talk deals", sub: "Book a call with me", href: "https://calendar.app.google/PeJusDq4kwcmC7AY9", external: true },
  { label: "Save my contact card", href: "/paul-kelton.vcf", download: true },
  { label: "About Paul Kelton", href: "https://www.mattoneillrealestate.com/agents/paul-kelton/", external: true },
  { label: "BiggerPockets", sub: "Elite Agent", href: "https://www.biggerpockets.com/co/more-commercial", external: true },
];

const tel = `tel:${site.phone_e164}`;
const sms = `sms:${site.phone_e164}`;
const mail = `mailto:${site.email}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e3640" />
    <Seo
      title="Paul Kelton | Charleston Real Estate – Links"
      description="Paul Kelton, Charleston investor-friendly agent. Market Monday, GRID Charleston events, book a call, and ways to reach Paul."
    />
  </head>
  <body>
    <main>
      <header class="top">
        <div class="mono" aria-hidden="true">PK</div>
        <h1>Paul Kelton</h1>
        <p class="role">Investor-friendly agent · Charleston</p>
        <p class="bio">Helping buyers, sellers and investors build wealth in Charleston.</p>

        <ul class="quick" aria-label="Reach Paul">
          <li><a href={tel}>Call</a></li>
          <li><a href={sms}>Text</a></li>
          <li><a href={mail}>Email</a></li>
          {site.social.instagram && <li><a href={site.social.instagram} rel="me noopener">Instagram</a></li>}
        </ul>
      </header>

      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a
                class:list={["btn", { featured: l.featured }]}
                href={l.href}
                {...(l.external ? { rel: "noopener" } : {})}
                {...(l.download ? { download: "paul-kelton.vcf" } : {})}
              >
                <span class="label">{l.label}</span>
                {l.sub && <span class="sub">{l.sub}</span>}
              </a>
            </li>
          ))
        }
      </ul>

      <footer>
        <p>{site.name}, {site.designation} · {site.brokerage_line}</p>
        <p>{officeAddressLine} · {site.brokerage_phone}</p>
        <p>Equal Housing Opportunity · <a href="/">paulchs.com</a></p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --oyster: #eef0eb;
    --pluff: #2b2420;
    --pluff-soft: #4a423c;
    --marsh: #3d5a2c;
    --piling: #1e3640;
    --spartina: #c9a24a;
    --white: #ffffff;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--oyster);
    color: var(--pluff);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 1.125rem;
    line-height: 1.5;
  }
  :focus-visible {
    outline: 3px solid var(--spartina);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>

<style>
  main {
    max-width: 34rem;
    margin: 0 auto;
    padding: 0 1.25rem 2.5rem;
  }
  .top {
    background: var(--piling);
    color: var(--oyster);
    text-align: center;
    margin: 0 -1.25rem;
    padding: 2.5rem 1.5rem 1.75rem;
    border-bottom: 4px solid var(--spartina);
  }
  @media (min-width: 34rem) {
    .top {
      margin: 1.5rem 0 0;
    }
  }
  .mono {
    width: 5.5rem;
    height: 5.5rem;
    margin: 0 auto 0.9rem;
    border-radius: 50%;
    border: 3px solid var(--spartina);
    display: grid;
    place-items: center;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  h1 {
    font-size: 1.875rem;
    line-height: 1.15;
    margin: 0;
  }
  .role {
    margin: 0.3rem 0 0.75rem;
    font-weight: 600;
    color: #d6dcd6;
  }
  .bio {
    margin: 0 auto;
    max-width: 24rem;
  }
  .quick {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .quick a {
    display: inline-block;
    color: var(--oyster);
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.45rem 0.95rem;
    border: 2px solid rgba(238, 240, 235, 0.55);
    border-radius: 999px;
    min-height: 2.75rem;
    line-height: 1.6;
  }
  .quick a:hover {
    border-color: var(--spartina);
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    gap: 0.85rem;
  }
  .btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.1rem;
    padding: 0.95rem 1.25rem;
    min-height: 3.5rem;
    justify-content: center;
    background: var(--white);
    color: var(--pluff);
    text-decoration: none;
    border: 2px solid var(--pluff);
    border-radius: 6px;
    box-shadow: 4px 4px 0 var(--pluff);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--pluff);
  }
  .btn.featured {
    background: var(--marsh);
    color: var(--white);
    border-color: var(--marsh);
    box-shadow: 4px 4px 0 var(--piling);
  }
  .label {
    font-weight: 700;
  }
  .sub {
    font-size: 0.9375rem;
    color: var(--pluff-soft);
  }
  .featured .sub {
    color: #e3ebde;
  }

  footer {
    margin-top: 2.25rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--pluff-soft);
  }
  footer p {
    margin: 0.2rem 0;
  }
  footer a {
    color: var(--pluff-soft);
  }
</style>
