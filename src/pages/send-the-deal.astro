---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, telHref, smsHref, officeAddressLine } from "../lib/site";
import { UNIT_OPTIONS, LIMITS } from "../lib/lead";

const responseTime = site.response_time;
const errors: Record<string, string> = {
  name: "Please add your name.",
  contact: "Please add a phone number or email where I can reach you.",
  address: "That address is a little long. A street address or an area name is plenty.",
  units: "Please pick a unit count from the list, or leave it blank.",
  notes: "That note is a little long. Send the short version and we'll talk through the rest.",
  photos: `Photos need to be ${LIMITS.photos} or fewer and under 4 MB total. You can also text them to me at ${site.phone}.`,
  offline: `The form isn't connected yet. Please call or text me at ${site.phone} – that comes straight to me.`,
  send: `Something went wrong sending that. Please try again, or call or text me at ${site.phone}.`,
};
---

<BaseLayout
  title="Send Me the Deal | Paul Kelton, Charleston Investor Agent"
  description="Send Paul Kelton a Charleston property, a question, or just a budget. Duplexes, small multifamily, and rentals. Call, text, or use the short form."
>
  <section class="section">
    <div class="wrap">
      <h1>Send me the deal.</h1>
      <p class="lead">
        You don't need it figured out. Send what you have and I'll get back to you within {responseTime}.
      </p>

      <div class="layout">
        <aside class="direct" aria-label="Reach Paul directly">
          <p class="direct-title">Rather talk?</p>
          <a class="direct-link" href={telHref} data-event="call_tap" data-where="send_the_deal">Call {site.phone}</a>
          <a class="direct-link" href={smsHref} data-event="text_tap" data-where="send_the_deal">Text Paul</a>
          <p class="small">{officeAddressLine}</p>
        </aside>

        <form id="form" method="post" action="/api/send-the-deal" enctype="multipart/form-data">
          <div class="alert" role="alert" aria-live="assertive" hidden></div>

          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength={LIMITS.name} />
          </div>

          <div class="field">
            <label for="contact">Phone or email</label>
            <input
              id="contact"
              name="contact"
              type="text"
              required
              maxlength={LIMITS.contact}
              aria-describedby="contact-hint"
            />
            <p class="hint" id="contact-hint">Whichever you'd rather I use.</p>
          </div>

          <div class="field">
            <label for="address">Property address <span class="opt">(or the area you're looking in)</span></label>
            <input id="address" name="address" type="text" autocomplete="street-address" maxlength={LIMITS.address} />
          </div>

          <div class="field">
            <label for="units">Number of units <span class="opt">(optional)</span></label>
            <select id="units" name="units">
              <option value="">Choose one</option>
              {UNIT_OPTIONS.map((u) => <option value={u}>{u}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="notes">Anything I should know? <span class="opt">(optional)</span></label>
            <textarea id="notes" name="notes" rows="5" maxlength={LIMITS.notes}></textarea>
          </div>

          <div class="field">
            <label for="photos">Photos <span class="opt">(optional, up to {LIMITS.photos})</span></label>
            <input id="photos" name="photos" type="file" accept="image/*" multiple aria-describedby="photos-hint" />
            <p class="hint" id="photos-hint">Under 4 MB total. Bigger files? Text them to me instead.</p>
          </div>

          <div class="honey" aria-hidden="true">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <button class="btn submit" type="submit">Send me the deal</button>
          <p class="small privacy-note">
            I use what you send only to get back to you about this property. <a href="/privacy">Privacy</a>.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ errors, maxBytes: LIMITS.photoBytesTotal, maxPhotos: LIMITS.photos }}>
  (function () {
    var form = document.getElementById("form");
    var alertBox = form.querySelector(".alert");
    function show(msg, focusId) {
      alertBox.textContent = msg;
      alertBox.hidden = false;
      var el = focusId && document.getElementById(focusId);
      if (el) el.setAttribute("aria-invalid", "true");
      alertBox.scrollIntoView({ block: "center" });
    }
    var code = new URLSearchParams(location.search).get("error");
    if (code) show(errors[code] || errors.send, code);

    form.addEventListener("submit", function (e) {
      var files = document.getElementById("photos").files || [];
      var total = 0;
      for (var i = 0; i < files.length; i++) total += files[i].size;
      if (files.length > maxPhotos || total > maxBytes) {
        e.preventDefault();
        show(errors.photos, "photos");
        return;
      }
      var btn = form.querySelector(".submit");
      btn.disabled = true;
      btn.textContent = "Sending…";
    });
  })();
</script>

<style>
  .layout {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
    .direct {
      order: 2;
    }
  }

  .direct {
    background: var(--piling);
    color: var(--oyster);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .direct-title {
    font-weight: 700;
    margin: 0;
  }
  .direct-link {
    color: var(--oyster);
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration-color: var(--spartina);
    padding-block: 0.25rem;
  }
  .direct .small {
    margin: var(--space-1) 0 0;
  }
  .direct :focus-visible {
    outline-color: var(--spartina);
  }

  form {
    max-width: 36rem;
  }
  .field {
    margin-bottom: var(--space-3);
  }
  label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .opt {
    font-weight: 400;
    color: var(--pluff-soft);
  }
  input[type="text"],
  select,
  textarea {
    width: 100%;
    font: inherit;
    color: var(--pluff);
    background: var(--white);
    border: 2px solid var(--pluff-soft);
    border-radius: 4px;
    padding: 0.7rem 0.8rem;
    min-height: 3rem;
  }
  input[type="file"] {
    font: inherit;
    font-size: 1rem;
    max-width: 100%;
  }
  [aria-invalid="true"] {
    border-color: #8a1c1c;
  }
  .hint {
    font-size: var(--text-small);
    color: var(--pluff-soft);
    margin: 0.35rem 0 0;
  }
  .honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .submit {
    width: 100%;
  }
  @media (min-width: 48rem) {
    .submit {
      width: auto;
    }
  }
  .submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .privacy-note {
    margin-top: var(--space-2);
  }
  .alert {
    border-left: 4px solid #8a1c1c;
    background: var(--white);
    padding: var(--space-2);
    margin-bottom: var(--space-3);
    font-weight: 700;
  }
</style>
